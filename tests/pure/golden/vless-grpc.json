{
  "log": {
    "level": "warn",
    "timestamp": false
  },
  "certificate": {
    "store": "mozilla"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "in",
      "listen": "127.0.0.1",
      "listen_port": 1824
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "g.example.com",
      "server_port": 443,
      "uuid": "11111111-2222-3333-4444-555555555555",
      "tls": {
        "enabled": true,
        "server_name": "g.example.com",
        "insecure": true,
        "alpn": [
          "h2",
          "http/1.1"
        ]
      },
      "transport": {
        "type": "grpc",
        "service_name": "svc"
      },
      "detour": "warp"
    },
    {
      "type": "socks",
      "tag": "warp",
      "server": "127.0.0.1",
      "server_port": 1823,
      "version": "5"
    }
  ],
  "route": {
    "final": "proxy"
  }
}
