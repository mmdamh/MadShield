diff --git a/core/internal/service/madshield_browser.go b/core/internal/service/madshield_browser.go
new file mode 100644
index 0000000..119bdce
--- /dev/null
+++ b/core/internal/service/madshield_browser.go
@@ -0,0 +1,67 @@
+package service
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/armanlife/firefox-vpn-client/core/internal/fxa"
+)
+
+// MadShield hook (see native/fxvpn/patches): two endpoints for the browser sign-in. Like every dashboard route they are
+// reachable only from this phone with the per-start token.
+
+const maxTokenLen = 8192
+
+// handleBrowserGrant answers with the OAuth grant request to send from the browser for a session token.
+func (s *dashboardServer) handleBrowserGrant(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		SessionToken string `json:"session_token"`
+	}
+	if !readJSON(w, r, &in) {
+		return
+	}
+	req, err := fxa.BrowserOAuthGrant(strings.TrimSpace(in.SessionToken))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, req)
+}
+
+// handleBrowserImport adds the account the browser signed in, from the OAuth tokens its grant request returned.
+func (s *dashboardServer) handleBrowserImport(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		Email        string `json:"email"`
+		AccessToken  string `json:"access_token"`
+		RefreshToken string `json:"refresh_token"`
+		Scope        string `json:"scope"`
+		ExpiresIn    int    `json:"expires_in"`
+	}
+	if !readJSON(w, r, &in) {
+		return
+	}
+	email := strings.TrimSpace(in.Email)
+	switch {
+	case email == "" || len(email) > 254 || !strings.Contains(email, "@"):
+		writeError(w, http.StatusBadRequest, "no email")
+		return
+	case in.AccessToken == "" || len(in.AccessToken) > maxTokenLen || len(in.RefreshToken) > maxTokenLen:
+		writeError(w, http.StatusBadRequest, "no usable token")
+		return
+	}
+	if in.ExpiresIn <= 0 || in.ExpiresIn > 7*24*3600 {
+		in.ExpiresIn = 24 * 3600
+	}
+	acc, err := s.d.addSignedInAccount(email, "", &fxa.TokenResponse{
+		AccessToken:  in.AccessToken,
+		RefreshToken: in.RefreshToken,
+		ExpiresIn:    in.ExpiresIn,
+		Scope:        in.Scope,
+		TokenType:    "bearer",
+	})
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]string{"id": acc.ID})
+}
