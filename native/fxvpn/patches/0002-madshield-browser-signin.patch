+++ b/core/internal/fxa/madshield_browser.go
@@ -0,0 +1,174 @@
+package fxa
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/armanlife/firefox-vpn-client/core/internal/controlplane"
+)
+
+// MadShield hook (see native/fxvpn/patches): the sign-in runs in a real browser engine (an Android WebView) because
+// Mozilla's bot check (Fastly) refuses the OAuth grant of a program that is not a browser. The WebView ends with a
+// session token; the grant request that turns it into OAuth tokens is built here, with this program's own signing,
+// and sent by the browser. Nothing here makes a network request.
+
+var sessionTokenHex = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+// OAuthGrantRequest is the request the browser sends: the URL, the Authorization header and the JSON body.
+type OAuthGrantRequest struct {
+	URL           string `json:"url"`
+	Authorization string `json:"authorization"`
+	Body          string `json:"body"`
+}
+
+// BrowserOAuthGrant builds the "fxa-credentials" grant request for sessionToken, the same one fxaOAuthToken sends.
+func BrowserOAuthGrant(sessionToken string) (*OAuthGrantRequest, error) {
+	if !sessionTokenHex.MatchString(sessionToken) {
+		return nil, errors.New("not a session token")
+	}
+	hawkID, hawkKey, err := deriveHawkCredentials(sessionToken, "sessionToken")
+	if err != nil {
+		return nil, err
+	}
+	body, err := json.Marshal(map[string]interface{}{
+		"client_id":   firefoxClientID,
+		"grant_type":  "fxa-credentials",
+		"scope":       oauthScope,
+		"access_type": "offline",
+	})
+	if err != nil {
+		return nil, err
+	}
+	target := fxaAuthServer + "/oauth/token"
+	header, err := standardHawkHeader("POST", target, hawkID, hawkKey, body)
+	if err != nil {
+		return nil, err
+	}
+	return &OAuthGrantRequest{URL: target, Authorization: header, Body: string(body)}, nil
+}
+
+// standardHawkHeader signs like the Hawk specification and like Firefox does: the payload hash and the MAC are base64
+// (hawkHeader above writes them in hex, which is its own format). Mozilla's server and its bot check see the request a
+// real browser would send.
+func standardHawkHeader(method, rawURL, hawkID string, hawkKey, payload []byte) (string, error) {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return "", err
+	}
+	nonceBytes := make([]byte, 6)
+	if _, err := rand.Read(nonceBytes); err != nil {
+		return "", fmt.Errorf("generating nonce: %w", err)
+	}
+	nonce := base64.RawURLEncoding.EncodeToString(nonceBytes)
+	ts := fmt.Sprintf("%d", time.Now().Unix())
+	port := u.Port()
+	if port == "" {
+		port = "443"
+	}
+	hash := ""
+	if len(payload) > 0 {
+		h := sha256.New()
+		h.Write([]byte("hawk.1.payload\napplication/json\n"))
+		h.Write(payload)
+		h.Write([]byte("\n"))
+		hash = base64.StdEncoding.EncodeToString(h.Sum(nil))
+	}
+	normalized := strings.Join([]string{"hawk.1.header", ts, nonce, strings.ToUpper(method), u.RequestURI(), u.Hostname(), port, hash, "", ""}, "\n")
+	mac := hmac.New(sha256.New, hawkKey)
+	mac.Write([]byte(normalized))
+	header := fmt.Sprintf(`Hawk id="%s", ts="%s", nonce="%s", mac="%s"`, hawkID, ts, nonce, base64.StdEncoding.EncodeToString(mac.Sum(nil)))
+	if hash != "" {
+		header += fmt.Sprintf(`, hash="%s"`, hash)
+	}
+	return header, nil
+}
+
+// NativeGrantResult is the answer of the grant request when this program sends it (see BrowserNativeGrant).
+type NativeGrantResult struct {
+	Status int    `json:"status"`
+	Body   string `json:"body"`
+	Diag   string `json:"diag"`
+}
+
+// printable reports whether s is non-empty (unless empty is allowed) printable ASCII of at most max bytes.
+func printable(s string, max int, allowEmpty bool) bool {
+	if len(s) > max || (s == "" && !allowEmpty) {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x20 || s[i] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+// BrowserNativeGrant sends the same grant request itself, with the cookies the browser holds for Mozilla's hosts (the
+// Fastly bot-check cookie among them) and the browser's User-Agent, through the control plane transport (TLS hello
+// split included). It is the way out when the browser's own request is refused. Only the grant URL is ever requested.
+func BrowserNativeGrant(ctx context.Context, sessionToken, cookies, userAgent string) (*NativeGrantResult, error) {
+	g, err := BrowserOAuthGrant(sessionToken)
+	if err != nil {
+		return nil, err
+	}
+	if !printable(cookies, 16384, true) || !printable(userAgent, 300, false) {
+		return nil, errors.New("bad cookies or user agent")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, g.URL, strings.NewReader(g.Body))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", g.Authorization)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "*/*")
+	req.Header.Set("User-Agent", userAgent)
+	req.Header.Set("Origin", "https://accounts.firefox.com")
+	req.Header.Set("Referer", "https://accounts.firefox.com/")
+	if cookies != "" {
+		req.Header.Set("Cookie", cookies)
+	}
+	resp, err := controlplane.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 16384))
+	if err != nil {
+		return nil, err
+	}
+	out := &NativeGrantResult{Status: resp.StatusCode, Body: string(body)}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		keys := make([]string, 0, len(resp.Header))
+		for k := range resp.Header {
+			if !strings.EqualFold(k, "Set-Cookie") {
+				keys = append(keys, k)
+			}
+		}
+		sort.Strings(keys)
+		var b strings.Builder
+		for _, k := range keys {
+			v := resp.Header.Get(k)
+			if len(v) > 60 {
+				v = v[:60]
+			}
+			b.WriteString(" " + strings.ToLower(k) + "=" + v)
+		}
+		out.Diag = b.String()
+	}
+	return out, nil
+}
