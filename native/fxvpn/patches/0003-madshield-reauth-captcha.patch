diff --git a/core/internal/fxa/madshield_events.go b/core/internal/fxa/madshield_events.go
new file mode 100644
index 0000000..4f7a9b2
--- /dev/null
+++ b/core/internal/fxa/madshield_events.go
@@ -0,0 +1,61 @@
+package fxa
+
+import (
+	"context"
+	"errors"
+)
+
+// MadShield: what the Fastly challenge flow tells a watcher (patch 0003).
+//
+// The flow in challenge.go and fxaDo knows things the caller cannot see from the final error alone: whether Fastly
+// answered a CAPTCHA with a new round, refused the post-back, accepted the cookie on the probe, or answered the original
+// request with HTTP 406 again after a solved challenge. A caller that wants them puts an observer in the context
+// (WithChallengeObserver); without one nothing is reported and nothing changes.
+//
+// An event never holds a CAPTCHA answer, a token, a cookie (name or value), a header or an account detail: only fixed
+// words, counts, HTTP statuses and host names of Mozilla's servers.
+
+// ChallengeEvent is one step of the challenge flow.
+type ChallengeEvent struct {
+	Kind    string   // one of the Ev constants
+	Attempt int      // the try of the original request (1-based), on the events of fxaDo; 0 on the others
+	Round   int      // the post-back round (1-based) inside one challenge flow, 0 when not in a round
+	Host    string   // the host the flow runs on, without the scheme
+	Status  int      // an HTTP status, where the event carries one
+	Result  string   // a short fixed word
+	Kinds   []string // the challenge types asked in the round ("pow", "pat", "clientmetrics", "captcha")
+}
+
+const (
+	EvAttempt   = "attempt"           // the account server answered 406 to try Attempt; the challenge is about to be solved
+	EvHost      = "host"              // the flow begins on Host
+	EvNoPage    = "no_challenge_page" // Host served a normal page: nothing to solve there
+	EvRound     = "round"             // Fastly asked Kinds in post-back round Round
+	EvPostBack  = "post_back"         // the post-back of the round was answered: Status, Result success|more|rejected|error
+	EvProbe     = "probe"             // the probe after "success": Result accepted|still_challenged
+	EvCookies   = "cookies"           // the solved cookie moved into the control plane's jar: Result installed|missing
+	EvSolved    = "solved"            // the flow on Host is complete
+	EvFailed    = "failed"            // the flow on Host ended with an error: Result probe|cookies|rounds|cancelled|other
+	EvRetry     = "retry"             // the original request is sent again after a solved challenge (Attempt is the new try)
+	EvReply     = "reply"             // the answer to a retried request: Status
+	EvGiveUp    = "give_up"           // every try was answered with 406 again
+	EvAlternate = "alternate"         // the refresh was sent another way (Result app|page|oauth_host); Status is the answer, 0 for none
+)
+
+type challengeObserverKey struct{}
+
+// WithChallengeObserver reports the steps of the challenge flows run with the returned context (and of the requests that
+// fxaDo retries) to obs. obs runs on the flow's goroutine: it must be quick and must not call back into this package.
+func WithChallengeObserver(ctx context.Context, obs func(ChallengeEvent)) context.Context {
+	return context.WithValue(ctx, challengeObserverKey{}, obs)
+}
+
+func emitChallenge(ctx context.Context, ev ChallengeEvent) {
+	if obs, _ := ctx.Value(challengeObserverKey{}).(func(ChallengeEvent)); obs != nil {
+		obs(ev)
+	}
+}
+
+// ErrChallengeStillRefused is the error of a request the account server kept answering with HTTP 406 even though every
+// challenge was solved (fxaDo gave up after its tries). Its text is the one this error always had.
+var ErrChallengeStillRefused = errors.New("Fastly anti-bot challenge still failing")
diff --git a/core/internal/fxa/madshield_events_test.go b/core/internal/fxa/madshield_events_test.go
new file mode 100644
index 0000000..47ecbf2
--- /dev/null
+++ b/core/internal/fxa/madshield_events_test.go
@@ -0,0 +1,597 @@
+package fxa
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/armanlife/firefox-vpn-client/core/internal/controlplane"
+)
+
+// MadShield (patch 0003): the real RefreshToken -> fxaDo -> solveFastlyChallenge path against a scripted stand-in for
+// Mozilla's edge (Fastly), reached through the control plane's transport seam. Nothing here touches the network.
+
+const testCaptchaImage = "data:image/png;base64,AQID"
+
+// fakeEdge answers like the edge in front of Mozilla's account server, as far as the solver and fxaDo can tell.
+type fakeEdge struct {
+	t      *testing.T
+	cookie string // the cookie value the edge accepts (unique per test: the control plane's jar outlives a test)
+
+	// plan says how the edge answers the post-back of round `round` (1-based) of flow number `flow` (1-based, counted from
+	// each challenge script fetched): "more" (asks a CAPTCHA round), "success", "success-nocookie", "reject" (HTTP 403),
+	// "error" (HTTP 500), "hang" (never answers).
+	plan func(flow, round int) string
+	// probeAccepts: the cookie is accepted on the solver's probe. apiAccepts: and on the account server's request.
+	probeAccepts bool
+	probeAlways  bool // the probe passes even without the cookie (a Fastly that said "success" and sent none)
+	apiAccepts   bool
+	// token answers the accepted refresh: status and body
+	tokenStatus int
+	tokenBody   string
+	// altAccepts: the way of sending the refresh the edge lets through without any cookie: "app" (the app's User-Agent),
+	// "page" (the Origin of Firefox's page) or "oauth_host" (the OAuth server's own host); "" for none.
+	altAccepts string
+
+	mu      sync.Mutex
+	flow    int
+	round   int
+	solved  bool     // the current flow's post-back said "success"
+	answers []string // the CAPTCHA answers that reached a post-back (to prove delivery, never logged)
+	calls   []string
+	primary []string // the Accept-Encoding of each refresh sent the first way (Firefox's User-Agent, the account host)
+}
+
+func newFakeEdge(t *testing.T) *fakeEdge {
+	e := &fakeEdge{
+		t: t, cookie: fmt.Sprintf("ok-%s-%d", strings.ReplaceAll(t.Name(), "/", "_"), time.Now().UnixNano()),
+		plan:         func(flow, round int) string { return map[int]string{1: "more", 2: "success"}[round] },
+		probeAccepts: true, apiAccepts: true,
+		tokenStatus: 200, tokenBody: `{"access_token":"A1","refresh_token":"","expires_in":3600,"scope":"s","token_type":"bearer"}`,
+	}
+	controlplane.SetTransport(e)
+	t.Cleanup(func() { controlplane.SetTransport(nil) })
+	return e
+}
+
+func (e *fakeEdge) hasCookie(r *http.Request, valid bool) bool {
+	return valid && strings.Contains(r.Header.Get("Cookie"), "fst="+e.cookie)
+}
+
+func reply(r *http.Request, status int, body string, hdr map[string]string) *http.Response {
+	h := http.Header{"Content-Type": {"text/html"}}
+	for k, v := range hdr {
+		h.Add(k, v)
+	}
+	return &http.Response{StatusCode: status, Status: fmt.Sprintf("%d %s", status, http.StatusText(status)), Header: h,
+		Body: io.NopCloser(strings.NewReader(body)), Request: r, ProtoMajor: 1, ProtoMinor: 1}
+}
+
+func powChallenge() string {
+	sum := sha256.Sum256([]byte("bXk"))
+	return fmt.Sprintf(`{"ty":"pow","data":{"base":"b","expires":"1","hmac":"h","hash":"%s"}}`, hex.EncodeToString(sum[:]))
+}
+
+func captchaChallenge() string {
+	return `{"ty":"captcha","data":{"image_b64":"` + testCaptchaImage + `"}}`
+}
+
+func (e *fakeEdge) RoundTrip(r *http.Request) (*http.Response, error) {
+	e.mu.Lock()
+	e.calls = append(e.calls, r.Method+" "+r.URL.Host+r.URL.Path)
+	e.mu.Unlock()
+	path := r.URL.Path
+	switch {
+	case r.Method == http.MethodGet && path == "/" && r.URL.Host == "api.accounts.firefox.com":
+		return reply(r, 200, `{"ok":true}`, nil), nil // the API host serves no challenge page
+	case r.Method == http.MethodGet && path == "/":
+		e.mu.Lock()
+		afterSuccess := e.solved
+		e.mu.Unlock()
+		if (e.probeAlways && afterSuccess) || e.hasCookie(r, e.probeAccepts) {
+			return reply(r, 200, "<html>Firefox Accounts</html>", nil), nil
+		}
+		return reply(r, 200, `<html>Client Challenge <script src="/_fs-ch-abc/script.js"></script></html>`, nil), nil
+	case strings.HasSuffix(path, "/script.js"):
+		e.mu.Lock()
+		e.flow++
+		e.round = 0
+		e.solved = false
+		e.mu.Unlock()
+		return reply(r, 200, `;init([`+powChallenge()+`], "tok1", "/_fs-ch-abc", true);`, nil), nil
+	case strings.HasSuffix(path, "/fst-post-back"):
+		var pb fastlyPostBack
+		body, _ := io.ReadAll(r.Body)
+		_ = json.Unmarshal(body, &pb)
+		e.mu.Lock()
+		e.round++
+		flow, round := e.flow, e.round
+		for _, d := range pb.Data {
+			if m, ok := d.(map[string]interface{}); ok && m["ty"] == "captcha" {
+				e.answers = append(e.answers, fmt.Sprint(m["answer"]))
+			}
+		}
+		e.mu.Unlock()
+		switch e.plan(flow, round) {
+		case "more":
+			return reply(r, 200, fmt.Sprintf(`{"status":"challenge","ch":[%s],"tok":"tok%d"}`, captchaChallenge(), round+1), nil), nil
+		case "success":
+			e.mu.Lock()
+			e.solved = true
+			e.mu.Unlock()
+			return reply(r, 200, `{"status":"success"}`, map[string]string{"Set-Cookie": "fst=" + e.cookie + "; Domain=firefox.com; Path=/"}), nil
+		case "success-nocookie":
+			e.mu.Lock()
+			e.solved = true
+			e.mu.Unlock()
+			return reply(r, 200, `{"status":"success"}`, nil), nil
+		case "reject":
+			return reply(r, 403, `{"error":"denied"}`, nil), nil
+		case "error":
+			return reply(r, 500, `oops`, nil), nil
+		case "hang":
+			<-r.Context().Done()
+			return nil, r.Context().Err()
+		}
+		e.t.Fatalf("no plan for flow %d round %d", flow, round)
+	case r.Method == http.MethodPost && path == "/v1/token" && r.URL.Host == "oauth.accounts.firefox.com":
+		if e.altAccepts != "oauth_host" && !e.hasCookie(r, e.apiAccepts) {
+			return reply(r, 406, "", nil), nil
+		}
+		return reply(r, e.tokenStatus, e.tokenBody, map[string]string{"Content-Type": "application/json"}), nil
+	case r.Method == http.MethodPost && path == "/v1/oauth/token":
+		ua := r.Header.Get("User-Agent")
+		switch {
+		case strings.HasPrefix(ua, "MozillaVPN") && e.altAccepts == "app",
+			r.Header.Get("Origin") != "" && e.altAccepts == "page":
+			return reply(r, e.tokenStatus, e.tokenBody, map[string]string{"Content-Type": "application/json"}), nil
+		}
+		if r.Header.Get("Origin") == "" && !strings.HasPrefix(ua, "MozillaVPN") {
+			e.mu.Lock()
+			e.primary = append(e.primary, r.Header.Get("Accept-Encoding"))
+			e.mu.Unlock()
+		}
+		if !e.hasCookie(r, e.apiAccepts) {
+			return reply(r, 406, "", nil), nil
+		}
+		return reply(r, e.tokenStatus, e.tokenBody, map[string]string{"Content-Type": "application/json"}), nil
+	}
+	e.t.Fatalf("unexpected request %s %s", r.Method, r.URL)
+	return nil, nil
+}
+
+// watch collects the events of a flow.
+type watch struct {
+	mu     sync.Mutex
+	events []ChallengeEvent
+}
+
+func (w *watch) note(ev ChallengeEvent) {
+	w.mu.Lock()
+	w.events = append(w.events, ev)
+	w.mu.Unlock()
+}
+
+func (w *watch) kinds() string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	var parts []string
+	for _, ev := range w.events {
+		s := ev.Kind
+		if ev.Result != "" {
+			s += ":" + ev.Result
+		}
+		parts = append(parts, s)
+	}
+	return strings.Join(parts, " ")
+}
+
+func (w *watch) first(kind string) (ChallengeEvent, bool) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	for _, ev := range w.events {
+		if ev.Kind == kind {
+			return ev, true
+		}
+	}
+	return ChallengeEvent{}, false
+}
+
+// refresh runs the real refresh with a CAPTCHA solver that answers `answer` and counts its calls.
+func refresh(t *testing.T, ctx context.Context, w *watch, answer string) (*TokenResponse, int, error) {
+	t.Helper()
+	calls := 0
+	solver := func(ctx context.Context, image string) (string, error) {
+		calls++
+		if image != testCaptchaImage {
+			t.Errorf("the solver got another picture: %q", image)
+		}
+		return answer, nil
+	}
+	ctx = WithCaptchaSolver(ctx, solver)
+	if w != nil {
+		ctx = WithChallengeObserver(ctx, w.note)
+	}
+	tok, err := RefreshToken(ctx, "old-refresh")
+	return tok, calls, err
+}
+
+func requireKinds(t *testing.T, w *watch, want string) {
+	t.Helper()
+	// the other ways of sending the refresh (EvAlternate) have tests of their own
+	var kept []string
+	for _, k := range strings.Fields(w.kinds()) {
+		if !strings.HasPrefix(k, EvAlternate) {
+			kept = append(kept, k)
+		}
+	}
+	if got := strings.Join(kept, " "); got != want {
+		t.Fatalf("events:\n got  %s\n want %s", got, want)
+	}
+}
+
+// A CAPTCHA answered, Fastly accepts, the original refresh is sent again and succeeds.
+func TestMadShieldChallengeSuccessfulCaptchaAndRefresh(t *testing.T) {
+	edge := newFakeEdge(t)
+	w := &watch{}
+	tok, calls, err := refresh(t, context.Background(), w, "k7Q2")
+	if err != nil || tok == nil || tok.AccessToken != "A1" {
+		t.Fatalf("refresh: %v %+v", err, tok)
+	}
+	if tok.RefreshToken != "old-refresh" {
+		t.Fatalf("a refresh that does not rotate keeps the refresh token, got %q", tok.RefreshToken)
+	}
+	if calls != 1 || len(edge.answers) != 1 || edge.answers[0] != "k7Q2" {
+		t.Fatalf("the answer must reach the post-back: solver calls=%d answers=%d", calls, len(edge.answers))
+	}
+	requireKinds(t, w, "attempt host no_challenge_page host round post_back:more round post_back:success probe:accepted cookies:installed solved retry reply")
+	if ev, _ := w.first(EvReply); ev.Attempt != 2 || ev.Status != 200 {
+		t.Fatalf("the retried request: %+v", ev)
+	}
+	// the events must never carry what the person typed
+	if fmt.Sprintf("%+v", w.events) != strings.ReplaceAll(fmt.Sprintf("%+v", w.events), "k7Q2", "") {
+		t.Fatal("an event holds the CAPTCHA answer")
+	}
+}
+
+// A valid-looking answer followed by another round is "more", not a rejection; rounds are counted.
+func TestMadShieldChallengeAdditionalAndConsecutiveRounds(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string {
+		return map[int]string{1: "more", 2: "more", 3: "more", 4: "success"}[round]
+	}
+	w := &watch{}
+	_, calls, err := refresh(t, context.Background(), w, "abcd")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if calls != 3 {
+		t.Fatalf("three CAPTCHA rounds: solver called %d times", calls)
+	}
+	if got := strings.Count(w.kinds(), "post_back:more"); got != 3 {
+		t.Fatalf("post_back:more x%d, events: %s", got, w.kinds())
+	}
+}
+
+// Fastly itself refusing the post-back (HTTP 4xx) is reported as a refusal, with its status.
+func TestMadShieldChallengeRejectedPostBack(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string { return map[int]string{1: "more", 2: "reject"}[round] }
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "nope")
+	if err == nil {
+		t.Fatal("a refused post-back must fail the refresh")
+	}
+	pb := w.events[indexOfKind(w, EvPostBack, "rejected")]
+	if pb.Status != 403 || pb.Round != 2 {
+		t.Fatalf("post-back event: %+v", pb)
+	}
+	if !strings.Contains(w.kinds(), "failed:other") || strings.Contains(w.kinds(), "solved") {
+		t.Fatalf("events: %s", w.kinds())
+	}
+}
+
+func indexOfKind(w *watch, kind, result string) int {
+	for i, ev := range w.events {
+		if ev.Kind == kind && ev.Result == result {
+			return i
+		}
+	}
+	panic("no event " + kind + ":" + result + " in " + w.kinds())
+}
+
+// A post-back that fails on the server (HTTP 5xx) is an error, not a refusal.
+func TestMadShieldChallengeFailedPostBack(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string { return "error" }
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "x")
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	if ev := w.events[indexOfKind(w, EvPostBack, "error")]; ev.Status != 500 {
+		t.Fatalf("post-back event: %+v", ev)
+	}
+}
+
+// Fastly says "success" but no cookie reaches the jar: missing session cookies.
+func TestMadShieldChallengeMissingSessionCookies(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string { return map[int]string{1: "more", 2: "success-nocookie"}[round] }
+	edge.probeAlways = true // so the flow reaches the step that carries the cookie over
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "x")
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	got := w.kinds()
+	if !strings.Contains(got, "cookies:missing") || !strings.Contains(got, "failed:cookies") || strings.Contains(got, "solved") {
+		t.Fatalf("events: %s", got)
+	}
+	if !errors.Is(err, errChallengeNoCookies) {
+		t.Fatalf("the error must say no cookie was issued, got %v", err)
+	}
+}
+
+// The cookie is not accepted on the probe (another exit IP / transport): the flow says so and fails, it does not retry
+// the original request as if the challenge were solved.
+func TestMadShieldChallengeExitChangeFailsTheProbe(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.probeAccepts = false
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "x")
+	if !errors.Is(err, errChallengeNotAccepted) {
+		t.Fatalf("want errChallengeNotAccepted, got %v", err)
+	}
+	got := w.kinds()
+	if !strings.Contains(got, "probe:still_challenged") || !strings.Contains(got, "failed:probe") || strings.Contains(got, "retry") {
+		t.Fatalf("events: %s", got)
+	}
+}
+
+// The challenge completes and the probe passes, but the account server keeps answering 406 to the original request: every
+// try is a new flow with a new CAPTCHA, the tries are bounded, and the end is the distinct "still refused" error.
+func TestMadShieldChallengeSolvedButRefreshStillRefused(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.apiAccepts = false
+	w := &watch{}
+	_, calls, err := refresh(t, context.Background(), w, "abcd")
+	if !errors.Is(err, ErrChallengeStillRefused) {
+		t.Fatalf("want ErrChallengeStillRefused, got %v", err)
+	}
+	if calls != maxChallengeAttempts {
+		t.Fatalf("one CAPTCHA per try: %d calls, want %d", calls, maxChallengeAttempts)
+	}
+	if _, ok := w.first(EvGiveUp); !ok || strings.Count(w.kinds(), "retry") != maxChallengeAttempts-1 {
+		t.Fatalf("events: %s", w.kinds())
+	}
+	if !strings.Contains(err.Error(), "406") {
+		t.Fatalf("the error keeps its old text, got %q", err)
+	}
+}
+
+// The challenge completes but the original refresh then fails with an account-server error (not a 406).
+func TestMadShieldChallengeSolvedThenRefreshFails(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.tokenStatus, edge.tokenBody = 401, `{"errno":110,"message":"Invalid token"}`
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "abcd")
+	if err == nil || errors.Is(err, ErrChallengeStillRefused) {
+		t.Fatalf("want an account-server error, got %v", err)
+	}
+	if ev, ok := w.first(EvReply); !ok || ev.Status != 401 {
+		t.Fatalf("reply event: %+v (%s)", ev, w.kinds())
+	}
+	if Message(err) != "Invalid token" {
+		t.Fatalf("message: %q", Message(err))
+	}
+}
+
+// Cancelling while the post-back is in flight ends the flow promptly with the context's error.
+func TestMadShieldChallengeCancelDuringVerification(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string { return map[int]string{1: "more", 2: "hang"}[round] }
+	w := &watch{}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { _, _, err := refresh(t, ctx, w, "abcd"); done <- err }()
+	waitFor(t, func() bool { edge.mu.Lock(); defer edge.mu.Unlock(); return len(edge.answers) == 1 })
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("want context.Canceled, got %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("the flow did not stop on cancel")
+	}
+	if !strings.Contains(w.kinds(), "failed:cancelled") {
+		t.Fatalf("events: %s", w.kinds())
+	}
+}
+
+// A deadline that passes while the post-back is in flight ends the flow with the context's deadline error.
+func TestMadShieldChallengeTimeoutDuringSubmission(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.plan = func(flow, round int) string { return map[int]string{1: "more", 2: "hang"}[round] }
+	ctx, cancel := context.WithTimeout(context.Background(), 400*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_, _, err := refresh(t, ctx, &watch{}, "abcd")
+	// fxaDo works on a context it derived (contextWithMinDeadline), so the parent's expiry reaches the request as a
+	// cancellation: the caller must read its own context to tell a timeout from a cancel (the renewal job does).
+	if !errors.Is(err, context.Canceled) && !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("want the context's error, got %v", err)
+	}
+	if !errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatalf("the caller's own context must report the deadline, got %v", ctx.Err())
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Fatal("the deadline was not honoured")
+	}
+}
+
+// Without an observer the flow behaves as before.
+func TestMadShieldChallengeWorksWithoutObserver(t *testing.T) {
+	newFakeEdge(t)
+	tok, calls, err := refresh(t, context.Background(), nil, "abcd")
+	if err != nil || tok == nil || calls != 1 {
+		t.Fatalf("refresh: %v %+v calls=%d", err, tok, calls)
+	}
+}
+
+// A CAPTCHA with no solver in the context keeps its old, plain error.
+func TestMadShieldChallengeWithoutSolverStillSaysSignInFromTheDashboard(t *testing.T) {
+	newFakeEdge(t)
+	_, err := RefreshToken(context.Background(), "old-refresh")
+	if err == nil || !strings.Contains(err.Error(), "Fastly requires an image CAPTCHA") {
+		t.Fatalf("got %v", err)
+	}
+}
+
+// Rotation: a refresh that returns a new refresh token passes it on.
+func TestMadShieldRefreshTokenRotationIsPassedOn(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.tokenBody = `{"access_token":"A2","refresh_token":"new-refresh","expires_in":3600,"scope":"s","token_type":"bearer"}`
+	tok, _, err := refresh(t, context.Background(), nil, "abcd")
+	if err != nil || tok.RefreshToken != "new-refresh" {
+		t.Fatalf("got %v %+v", err, tok)
+	}
+}
+
+func waitFor(t *testing.T, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("condition not reached")
+}
+
+// altResults are the Result and Status of the EvAlternate events, "app:406 page:406 oauth_host:406".
+func altResults(w *watch) string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	var parts []string
+	for _, ev := range w.events {
+		if ev.Kind == EvAlternate {
+			parts = append(parts, fmt.Sprintf("%s:%d", ev.Result, ev.Status))
+		}
+	}
+	return strings.Join(parts, " ")
+}
+
+// The edge refuses the refresh the usual way, however many challenges are solved, and lets the app's way through: no
+// CAPTCHA may be asked.
+func TestMadShieldRefreshOtherWaysBeforeAnyCaptcha(t *testing.T) {
+	for _, way := range []string{"app", "page", "oauth_host"} {
+		t.Run(way, func(t *testing.T) {
+			edge := newFakeEdge(t)
+			edge.altAccepts = way
+			edge.apiAccepts = false // no cookie ever opens the usual way
+			w := &watch{}
+			tok, calls, err := refresh(t, context.Background(), w, "k7Q2")
+			if err != nil || tok == nil || tok.AccessToken != "A1" {
+				t.Fatalf("refresh: %v %+v", err, tok)
+			}
+			if calls != 0 || len(edge.answers) != 0 {
+				t.Fatalf("a CAPTCHA was asked although another way works: calls=%d", calls)
+			}
+			if _, solved := w.first(EvSolved); solved {
+				t.Fatal("a challenge was solved although another way works")
+			}
+			got := altResults(w)
+			if !strings.HasSuffix(got, way+":200") {
+				t.Fatalf("alternates: %s", got)
+			}
+		})
+	}
+}
+
+// When no other way is let through either, the challenge still runs as before, and the other ways were tried once for
+// each of the first answers of 406.
+func TestMadShieldRefreshOtherWaysRefusedThenChallenge(t *testing.T) {
+	edge := newFakeEdge(t)
+	w := &watch{}
+	tok, calls, err := refresh(t, context.Background(), w, "k7Q2")
+	if err != nil || tok == nil || calls != 1 {
+		t.Fatalf("refresh: %v %+v calls=%d", err, tok, calls)
+	}
+	if got := altResults(w); got != "app:406 page:406 oauth_host:406" {
+		t.Fatalf("alternates: %s", got)
+	}
+	_ = edge
+}
+
+// Every try refused: the other ways are tried for the first alternateAttempts answers only, not after every challenge.
+func TestMadShieldRefreshOtherWaysAreBounded(t *testing.T) {
+	edge := newFakeEdge(t)
+	edge.apiAccepts = false
+	w := &watch{}
+	_, _, err := refresh(t, context.Background(), w, "k7Q2")
+	if !errors.Is(err, ErrChallengeStillRefused) {
+		t.Fatalf("want ErrChallengeStillRefused, got %v", err)
+	}
+	if n := strings.Count(altResults(w), "app:"); n != alternateAttempts {
+		t.Fatalf("the other ways were tried %d times, want %d", n, alternateAttempts)
+	}
+}
+
+// The refresh sent the usual way does not carry net/http's own gzip.
+func TestMadShieldRefreshAsksForNoCompression(t *testing.T) {
+	edge := newFakeEdge(t)
+	if _, _, err := refresh(t, context.Background(), nil, "k7Q2"); err != nil {
+		t.Fatal(err)
+	}
+	if len(edge.primary) == 0 {
+		t.Fatal("no refresh was sent the usual way")
+	}
+	for _, enc := range edge.primary {
+		if enc != "identity" {
+			t.Fatalf("Accept-Encoding %q, want identity", enc)
+		}
+	}
+}
+
+// What the edge says about an answer that is not the account server's own (an HTML page, an edge error) is not taken as
+// the answer to the refresh: the next way, then the challenge, follow.
+func TestMadShieldAccountServerAnswerIsToldFromTheEdge(t *testing.T) {
+	if !isAccountServerAnswer([]byte(`{"code":400,"errno":107,"error":"Invalid parameter"}`)) {
+		t.Fatal("an errno body is the account server's")
+	}
+	for _, body := range []string{"", "<html>blocked</html>", `{"error":"denied"}`, `{"errno":0}`} {
+		if isAccountServerAnswer([]byte(body)) {
+			t.Fatalf("%q is not the account server's", body)
+		}
+	}
+}
+
+// The solved cookie must be installed for the OAuth server's host too (it comes out of the solver's jar without its
+// Domain, so each host needs its own copy).
+func TestMadShieldSolvedCookieReachesTheOAuthHost(t *testing.T) {
+	newFakeEdge(t)
+	if _, _, err := refresh(t, context.Background(), nil, "k7Q2"); err != nil {
+		t.Fatal(err)
+	}
+	req, _ := http.NewRequest(http.MethodPost, browserOAuthTokenURL, strings.NewReader("{}"))
+	resp, err := controlplane.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("the OAuth host answered %d: the challenge cookie did not reach it", resp.StatusCode)
+	}
+}
diff --git a/core/internal/fxa/madshield_refresh.go b/core/internal/fxa/madshield_refresh.go
new file mode 100644
index 0000000..bf8a861
--- /dev/null
+++ b/core/internal/fxa/madshield_refresh.go
@@ -0,0 +1,73 @@
+package fxa
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+)
+
+// MadShield: the other ways a refresh is sent (patch 0003).
+//
+// A refresh the edge answers with HTTP 406 is not always about a missing cookie: the same request can be refused again
+// after any number of solved challenges when what the edge dislikes is the way the request presents itself. Then another
+// CAPTCHA is asked for nothing. So, before a challenge is solved, the refresh is sent the other ways this program already
+// presents itself to the account server for the browser sign-in (see madshield_browser.go): as the app (its own
+// User-Agent, Go's own TLS, HTTP/2 where the server takes it), as Firefox's page (origin and fetch metadata), and to the
+// OAuth server's own host. The first answer that is not a refusal wins. Nothing here weakens a check: a request that is
+// refused is only sent differently, never without the credentials it needs, and the challenge stays the way through.
+
+// alternateAttempts is how many answers of 406 (counted from the first) are followed by the other ways before the challenge.
+const alternateAttempts = 2
+
+// The words of EvAlternate's Result.
+const (
+	altApp       = "app"
+	altPage      = "page"
+	altOAuthHost = "oauth_host"
+)
+
+// refreshAlternate sends the refresh body the other ways. It returns nil, nil when every way was refused (406), failed, or
+// answered with something that is not the account server's own word (an edge's page).
+func refreshAlternate(body []byte) func(ctx context.Context, attempt int) (*http.Response, error) {
+	return func(ctx context.Context, attempt int) (*http.Response, error) {
+		for _, way := range []struct {
+			name   string
+			target string
+			who    int
+		}{
+			{altApp, fxaAuthServer + "/oauth/token", asApp},
+			{altPage, fxaAuthServer + "/oauth/token", asFirefoxPage},
+			{altOAuthHost, browserOAuthTokenURL, asFirefox},
+		} {
+			a, err := send(ctx, http.MethodPost, way.target, body, "", nil, way.who)
+			if ctx.Err() != nil {
+				return nil, ctx.Err()
+			}
+			if err != nil {
+				emitChallenge(ctx, ChallengeEvent{Kind: EvAlternate, Attempt: attempt, Result: way.name})
+				continue
+			}
+			emitChallenge(ctx, ChallengeEvent{Kind: EvAlternate, Attempt: attempt, Result: way.name, Status: a.status})
+			if a.status == http.StatusOK || isAccountServerAnswer(a.body) {
+				return &http.Response{
+					StatusCode: a.status,
+					Status:     http.StatusText(a.status),
+					Header:     http.Header{"Content-Type": {"application/json"}},
+					Body:       io.NopCloser(bytes.NewReader(a.body)),
+				}, nil
+			}
+		}
+		return nil, nil
+	}
+}
+
+// isAccountServerAnswer reports whether body is an error the account server itself wrote (it carries an errno): an
+// answer to the credentials, as opposed to the edge's refusal (406, an HTML page, an empty body).
+func isAccountServerAnswer(body []byte) bool {
+	var e struct {
+		Errno int `json:"errno"`
+	}
+	return json.Unmarshal(body, &e) == nil && e.Errno > 0
+}
diff --git a/core/internal/proxy/madshield_reauth.go b/core/internal/proxy/madshield_reauth.go
new file mode 100644
index 0000000..3f136d5
--- /dev/null
+++ b/core/internal/proxy/madshield_reauth.go
@@ -0,0 +1,105 @@
+package proxy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/armanlife/firefox-vpn-client/core/internal/accounts"
+	"github.com/armanlife/firefox-vpn-client/core/internal/fxa"
+)
+
+// ErrRenewSuperseded is returned when the account's credentials were replaced (or the account was forgotten) while a
+// renewal was waiting on Mozilla: what it obtained is dropped, so it cannot overwrite anything newer.
+var ErrRenewSuperseded = errors.New("the account's sign-in changed while it was being renewed")
+
+// RenewPersistError says the renewed tokens could not be saved to the account's file. InUse reports whether they are used
+// from memory anyway: that is so when Mozilla rotated the refresh token, because the old one may no longer work and the
+// new one must not be lost. Otherwise the stored sign-in stays as it was, and it is still good.
+type RenewPersistError struct {
+	Err   error
+	InUse bool
+}
+
+func (e *RenewPersistError) Error() string {
+	if e.InUse {
+		return fmt.Sprintf("the renewed sign-in works for now but could not be saved: %v", e.Err)
+	}
+	return fmt.Sprintf("the renewed sign-in could not be saved; the stored one is unchanged: %v", e.Err)
+}
+func (e *RenewPersistError) Unwrap() error { return e.Err }
+
+// PersistFailed lets the dashboard name this failure without importing this package's type.
+func (e *RenewPersistError) PersistFailed() bool { return true }
+
+// RenewAccessToken makes the account's access token fresh (MadShield: an account page asked for it, and a person is
+// waiting to answer Fastly's image CAPTCHA, so the usual 15 s limit of a background refresh does not apply: ctx sets
+// the time). It reports whether a refresh was needed; a token that is still good is left alone.
+//
+// The new tokens replace the old ones in one step: written to the account's file first, then put in the pool's memory,
+// both under the pool's lock and only if the pool still holds the credentials the refresh started from. So a failed
+// renewal changes nothing, a renewal that ended (cancelled, timed out) installs nothing, and one that lost a race with a
+// newer refresh does not overwrite it.
+func (p *AccountPool) RenewAccessToken(ctx context.Context, acc accounts.Account) (bool, error) {
+	return p.renewAccessToken(ctx, acc, fxa.RefreshToken)
+}
+
+func (p *AccountPool) renewAccessToken(ctx context.Context, acc accounts.Account, refresh func(context.Context, string) (*fxa.TokenResponse, error)) (bool, error) {
+	auth, err := p.AuthFor(acc)
+	if err != nil {
+		return false, err
+	}
+	if auth.accessTokenValid(time.Now()) {
+		return false, nil
+	}
+	if auth.Token == nil || auth.Token.RefreshToken == "" {
+		return false, fmt.Errorf("%w: no refresh token stored", fxa.ErrReauthRequired)
+	}
+	token, err := refresh(ctx, auth.Token.RefreshToken)
+	if err != nil {
+		return false, err
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err // the renewal ended while the answer was on its way: nothing is installed
+	}
+	if token.RefreshToken == "" {
+		token.RefreshToken = auth.Token.RefreshToken // a refresh may not rotate it (fxa.RefreshToken already keeps it)
+	}
+	renewed := &runtimeAuth{Token: token, ObtainedAt: time.Now(), persist: auth.persist, accountID: auth.accountID}
+	return p.installRenewed(auth, renewed)
+}
+
+// installRenewed puts next in place of prev, which the refresh started from. It reports true when the account holds
+// fresh credentials afterwards.
+func (p *AccountPool) installRenewed(prev, next *runtimeAuth) (bool, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	cur, ok := p.auths[next.accountID]
+	if !ok {
+		return false, ErrRenewSuperseded // the account was forgotten meanwhile
+	}
+	if cur != prev {
+		// Credentials were installed after the refresh began (a background refresh): they are newer, keep them.
+		if cur.accessTokenValid(time.Now()) {
+			return true, nil
+		}
+		return false, ErrRenewSuperseded
+	}
+	err := p.store.SaveCredentials(next.accountID, &fxa.SavedTokens{
+		AccessToken:  next.Token.AccessToken,
+		RefreshToken: next.Token.RefreshToken,
+		Scope:        next.Token.Scope,
+		ObtainedAt:   next.ObtainedAt,
+		ExpiresIn:    next.Token.ExpiresIn,
+	})
+	if err != nil {
+		rotated := next.Token.RefreshToken != prev.Token.RefreshToken
+		if rotated {
+			p.auths[next.accountID] = next
+		}
+		return true, &RenewPersistError{Err: err, InUse: rotated}
+	}
+	p.auths[next.accountID] = next
+	return true, nil
+}
diff --git a/core/internal/proxy/madshield_reauth_test.go b/core/internal/proxy/madshield_reauth_test.go
new file mode 100644
index 0000000..e51a515
--- /dev/null
+++ b/core/internal/proxy/madshield_reauth_test.go
@@ -0,0 +1,287 @@
+package proxy
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/armanlife/firefox-vpn-client/core/internal/accounts"
+	"github.com/armanlife/firefox-vpn-client/core/internal/fxa"
+)
+
+// MadShield (patch 0003): what a renewal does to the account's credentials, against the real account store.
+
+type renewFixture struct {
+	t     *testing.T
+	pool  *AccountPool
+	store *accounts.Store
+	acc   accounts.Account
+	dir   string
+}
+
+// newRenewFixture stores an account whose access token has expired (its refresh token is "old-refresh").
+func newRenewFixture(t *testing.T) *renewFixture {
+	t.Helper()
+	dir := t.TempDir()
+	store, err := accounts.OpenStore(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	acc, _, err := store.Add("renew@example.invalid", &fxa.SavedTokens{
+		AccessToken: "old-access", RefreshToken: "old-refresh", Scope: "s", ExpiresIn: 3600,
+		ObtainedAt: time.Now().Add(-2 * time.Hour),
+	}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &renewFixture{t: t, pool: NewAccountPool(store, nil), store: store, acc: acc, dir: dir}
+}
+
+func (f *renewFixture) stored() *fxa.SavedTokens {
+	f.t.Helper()
+	creds, err := f.store.Credentials(f.acc.ID)
+	if err != nil {
+		f.t.Fatal(err)
+	}
+	return creds
+}
+
+func (f *renewFixture) cached() *runtimeAuth {
+	f.pool.mu.Lock()
+	defer f.pool.mu.Unlock()
+	return f.pool.auths[f.acc.ID]
+}
+
+func (f *renewFixture) breakStore() {
+	f.t.Helper()
+	matches, _ := filepath.Glob(filepath.Join(f.dir, "*", f.acc.ID))
+	if len(matches) != 1 {
+		f.t.Fatalf("account dir not found: %v", matches)
+	}
+	if err := os.RemoveAll(matches[0]); err != nil {
+		f.t.Fatal(err)
+	}
+	if err := os.WriteFile(matches[0], []byte("not a directory"), 0o600); err != nil {
+		f.t.Fatal(err)
+	}
+}
+
+func refreshing(refresh, access string) func(context.Context, string) (*fxa.TokenResponse, error) {
+	return func(context.Context, string) (*fxa.TokenResponse, error) {
+		return &fxa.TokenResponse{AccessToken: access, RefreshToken: refresh, ExpiresIn: 3600, Scope: "s", TokenType: "bearer"}, nil
+	}
+}
+
+// Refresh-token rotation: the new refresh token replaces the old one in memory and on disk, together.
+func TestMadShieldRenewRotatesTheRefreshToken(t *testing.T) {
+	f := newRenewFixture(t)
+	renewed, err := f.pool.renewAccessToken(context.Background(), f.acc, refreshing("new-refresh", "new-access"))
+	if err != nil || !renewed {
+		t.Fatalf("renewed=%v err=%v", renewed, err)
+	}
+	if got := f.stored(); got.RefreshToken != "new-refresh" || got.AccessToken != "new-access" {
+		t.Fatalf("stored: %+v", got)
+	}
+	if c := f.cached(); c.Token.RefreshToken != "new-refresh" || !c.accessTokenValid(time.Now()) {
+		t.Fatalf("cached: %+v", c.Token)
+	}
+}
+
+// A refresh that does not rotate keeps the stored refresh token.
+func TestMadShieldRenewKeepsTheRefreshTokenWhenNotRotated(t *testing.T) {
+	f := newRenewFixture(t)
+	if _, err := f.pool.renewAccessToken(context.Background(), f.acc, refreshing("", "new-access")); err != nil {
+		t.Fatal(err)
+	}
+	if got := f.stored(); got.RefreshToken != "old-refresh" || got.AccessToken != "new-access" {
+		t.Fatalf("stored: %+v", got)
+	}
+}
+
+// A token that is still good is not refreshed.
+func TestMadShieldRenewLeavesAValidTokenAlone(t *testing.T) {
+	f := newRenewFixture(t)
+	if err := f.store.SaveCredentials(f.acc.ID, &fxa.SavedTokens{AccessToken: "good", RefreshToken: "r", ExpiresIn: 3600, ObtainedAt: time.Now()}); err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	renewed, err := f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+		called = true
+		return nil, errors.New("must not be called")
+	})
+	if renewed || err != nil || called {
+		t.Fatalf("renewed=%v err=%v called=%v", renewed, err, called)
+	}
+}
+
+// A failed renewal changes nothing: the previous session stays valid in memory and on disk.
+func TestMadShieldFailedRenewalKeepsThePreviousSession(t *testing.T) {
+	f := newRenewFixture(t)
+	before := f.stored()
+	_, err := f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+		return nil, errors.New("Fastly anti-bot challenge still failing")
+	})
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	if got := f.stored(); *got != *before {
+		t.Fatalf("stored credentials changed: %+v -> %+v", before, got)
+	}
+	if c := f.cached(); c == nil || c.Token.RefreshToken != "old-refresh" || c.Token.AccessToken != "old-access" {
+		t.Fatalf("cached credentials changed: %+v", c)
+	}
+}
+
+// A renewal that ended (cancelled / timed out) while Mozilla's answer was on its way installs nothing.
+func TestMadShieldCancelledRenewalInstallsNothing(t *testing.T) {
+	f := newRenewFixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	_, err := f.pool.renewAccessToken(ctx, f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+		cancel() // the person cancels just as the token arrives
+		return &fxa.TokenResponse{AccessToken: "new", RefreshToken: "new-refresh", ExpiresIn: 3600}, nil
+	})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("got %v", err)
+	}
+	if got := f.stored(); got.RefreshToken != "old-refresh" || f.cached().Token.AccessToken != "old-access" {
+		t.Fatalf("a cancelled renewal wrote credentials: %+v", got)
+	}
+}
+
+// Persistence failure, refresh token not rotated: surfaced; the stored session stays as it was (still good).
+func TestMadShieldPersistFailureWithoutRotationKeepsTheOldSession(t *testing.T) {
+	f := newRenewFixture(t)
+	if _, err := f.pool.AuthFor(f.acc); err != nil { // load into memory before the store breaks
+		t.Fatal(err)
+	}
+	f.breakStore()
+	renewed, err := f.pool.renewAccessToken(context.Background(), f.acc, refreshing("", "new-access"))
+	var pe *RenewPersistError
+	if !errors.As(err, &pe) || !pe.PersistFailed() || pe.InUse || !renewed {
+		t.Fatalf("renewed=%v err=%v", renewed, err)
+	}
+	if c := f.cached(); c.Token.AccessToken != "old-access" || c.Token.RefreshToken != "old-refresh" {
+		t.Fatalf("memory must keep the stored session: %+v", c.Token)
+	}
+}
+
+// Persistence failure after rotation: the new refresh token is the only good one, so memory keeps it, and the error says so.
+func TestMadShieldPersistFailureAfterRotationKeepsTheNewTokenInMemory(t *testing.T) {
+	f := newRenewFixture(t)
+	if _, err := f.pool.AuthFor(f.acc); err != nil {
+		t.Fatal(err)
+	}
+	f.breakStore()
+	_, err := f.pool.renewAccessToken(context.Background(), f.acc, refreshing("rotated", "new-access"))
+	var pe *RenewPersistError
+	if !errors.As(err, &pe) || !pe.InUse {
+		t.Fatalf("err=%v", err)
+	}
+	if c := f.cached(); c.Token.RefreshToken != "rotated" {
+		t.Fatalf("the rotated refresh token was lost: %+v", c.Token)
+	}
+}
+
+// A renewal that lost a race with a newer refresh does not overwrite it.
+func TestMadShieldStaleRenewalDoesNotOverwriteNewerCredentials(t *testing.T) {
+	f := newRenewFixture(t)
+	inFlight, proceed := make(chan struct{}), make(chan struct{})
+	done := make(chan error, 1)
+	var renewed bool
+	go func() {
+		var err error
+		renewed, err = f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+			close(inFlight)
+			<-proceed
+			return &fxa.TokenResponse{AccessToken: "slow-access", RefreshToken: "slow-refresh", ExpiresIn: 3600}, nil
+		})
+		done <- err
+	}()
+	<-inFlight
+	// meanwhile a background refresh installs newer credentials the way the pool does
+	newer := &runtimeAuth{Token: &fxa.TokenResponse{AccessToken: "fast-access", RefreshToken: "fast-refresh", ExpiresIn: 3600}, ObtainedAt: time.Now(), persist: f.pool.persist, accountID: f.acc.ID}
+	if err := newer.save(); err != nil {
+		t.Fatal(err)
+	}
+	close(proceed)
+	if err := <-done; err != nil || !renewed {
+		t.Fatalf("renewed=%v err=%v", renewed, err)
+	}
+	if got := f.stored(); got.AccessToken != "fast-access" || got.RefreshToken != "fast-refresh" {
+		t.Fatalf("the stale renewal overwrote the newer credentials on disk: %+v", got)
+	}
+	if c := f.cached(); c != newer {
+		t.Fatalf("the stale renewal replaced the newer credentials in memory: %+v", c.Token)
+	}
+}
+
+// If the newer credentials are not usable either, the renewal says it was superseded instead of pretending.
+func TestMadShieldSupersededRenewalIsReportedWhenNothingFreshRemains(t *testing.T) {
+	f := newRenewFixture(t)
+	_, err := f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+		stale := &runtimeAuth{Token: &fxa.TokenResponse{AccessToken: "x", RefreshToken: "y", ExpiresIn: 1}, ObtainedAt: time.Now().Add(-time.Hour), persist: f.pool.persist, accountID: f.acc.ID}
+		_ = stale.save()
+		return &fxa.TokenResponse{AccessToken: "n", RefreshToken: "m", ExpiresIn: 3600}, nil
+	})
+	if !errors.Is(err, ErrRenewSuperseded) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+// An account forgotten while it was being renewed is not brought back.
+func TestMadShieldRenewalOfAForgottenAccountInstallsNothing(t *testing.T) {
+	f := newRenewFixture(t)
+	_, err := f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+		f.pool.Forget(f.acc.ID)
+		return &fxa.TokenResponse{AccessToken: "n", RefreshToken: "m", ExpiresIn: 3600}, nil
+	})
+	if !errors.Is(err, ErrRenewSuperseded) {
+		t.Fatalf("got %v", err)
+	}
+	if f.cached() != nil || f.stored().RefreshToken != "old-refresh" {
+		t.Fatal("a forgotten account was written back")
+	}
+}
+
+// Concurrent renewals (and a concurrent reader) end with memory and disk saying the same thing.
+func TestMadShieldConcurrentRenewalsEndConsistent(t *testing.T) {
+	f := newRenewFixture(t)
+	var calls int32
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := f.pool.renewAccessToken(context.Background(), f.acc, func(context.Context, string) (*fxa.TokenResponse, error) {
+				n := atomic.AddInt32(&calls, 1)
+				time.Sleep(time.Millisecond)
+				return &fxa.TokenResponse{AccessToken: "a", RefreshToken: "r" + string(rune('0'+n)), ExpiresIn: 3600}, nil
+			})
+			if err != nil {
+				t.Errorf("renewal: %v", err)
+			}
+			_, _ = f.pool.AuthFor(f.acc)
+		}()
+	}
+	wg.Wait()
+	if c, s := f.cached(), f.stored(); c.Token.RefreshToken != s.RefreshToken || c.Token.AccessToken != s.AccessToken {
+		t.Fatalf("memory %q and disk %q disagree", c.Token.RefreshToken, s.RefreshToken)
+	}
+}
+
+// With no refresh token stored the answer is "sign in again", as before.
+func TestMadShieldRenewWithoutARefreshTokenAsksForSignIn(t *testing.T) {
+	f := newRenewFixture(t)
+	if err := f.store.SaveCredentials(f.acc.ID, &fxa.SavedTokens{AccessToken: "a", ExpiresIn: 1, ObtainedAt: time.Now().Add(-time.Hour)}); err != nil {
+		t.Fatal(err)
+	}
+	_, err := f.pool.renewAccessToken(context.Background(), f.acc, refreshing("x", "y"))
+	if !errors.Is(err, fxa.ErrReauthRequired) {
+		t.Fatalf("got %v", err)
+	}
+}
