    <string name="lbl_mtu">MTU: %1$d</string>
    <string name="mtu_help">۱۲۸۰ امن‌ترین مقدار در شبکه موبایل است. فقط در صورت کندی سرعت آن را بالا ببرید. مخصوص حالت VPN است.</string>
    <string name="mtu_capped">این پروتکل حداکثر %1$d را پشتیبانی می‌کند، پس همان مقدار استفاده می‌شود.</string>
