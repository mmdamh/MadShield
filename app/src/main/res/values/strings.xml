    <string name="sec_privacy">Privacy</string>
    <string name="privacy_body">• No analytics or crash-reporting SDK is built into this app.\n• Engine logs stay in memory only and are wiped on disconnect.\n• Settings never leave the device; there is no backend.\n• App backup and cloud transfer of app data are disabled.</string>
    <string name="dns_subtitle">Resolvers, speed test and the ECH lookup</string>
