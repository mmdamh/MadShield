    <string name="sec_protection">Protection</string>
    <string name="sw_exit_guard">Refuse an Iranian exit IP</string>
    <string name="sw_exit_guard_sub">The core checks the exit country before the proxy opens and every minute after. A tunnel that lands in Iran is dropped and replaced.</string>
    <string name="sw_kill">Kill switch</string>
    <string name="sw_kill_sub">VPN mode only. If the tunnel drops, traffic is held instead of falling back to your raw connection.</string>
