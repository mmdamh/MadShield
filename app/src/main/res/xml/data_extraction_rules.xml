<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- allowBackup is already false, this is belt-and-suspenders for the
         device-transfer path Android added separately from classic backup. -->
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
